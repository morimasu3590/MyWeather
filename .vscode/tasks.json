{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}/be/MyWeather.Api" },
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "MyWeather.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-webapi",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "MyWeather.WebApi/MyWeather.WebApi.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "MyWeather.WebApi/MyWeather.WebApi.csproj", "--launch-profile", "https"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "MyWeather.slnx"],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
